[
  {
    "name": "tier1_clean",
    "target": "main",
    "steps": [
      {
        "write": [
          "shared.txt",
          "line1\nline2\nline3\n"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-q",
          "-m",
          "initial"
        ]
      },
      {
        "git": [
          "checkout",
          "-q",
          "-b",
          "agent"
        ]
      },
      {
        "write": [
          "new-file.txt",
          "no conflict"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-q",
          "-m",
          "task"
        ]
      },
      {
        "rev": "h"
      },
      {
        "git": [
          "checkout",
          "-q",
          "main"
        ]
      }
    ],
    "applies": [
      {
        "id": "t1",
        "hash": "${h}",
        "branch": "agent"
      }
    ],
    "inspect": [
      "new-file.txt",
      "shared.txt"
    ],
    "expected": {
      "results": [
        {
          "taskId": "t1",
          "success": true,
          "resolvedTier": 1,
          "error": null,
          "hasCommitHash": true
        }
      ],
      "files": {
        "new-file.txt": "no conflict",
        "shared.txt": "line1\nline2\nline3\n"
      },
      "history": {},
      "startTiers": {},
      "porcelainClean": true,
      "cherryPickInProgress": false
    }
  },
