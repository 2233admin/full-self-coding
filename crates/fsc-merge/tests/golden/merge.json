  {
    "name": "tier2_blocked_contentful_canonical",
    "target": "main",
    "steps": [
      {
        "write": [
          "conflict.txt",
          "original content\n"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-q",
          "-m",
          "base"
        ]
      },
      {
        "rev": "base"
      },
      {
        "write": [
          "conflict.txt",
          "main's important change\n"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-q",
          "-m",
          "main change"
        ]
      },
      {
        "git": [
          "checkout",
          "-q",
          "-b",
          "agent",
          "${base}"
        ]
      },
      {
        "write": [
          "conflict.txt",
          "agent's different change\n"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
        "git": [
          "commit",
          "-q",
          "-m",
          "agent change"
        ]
      },
      {
        "rev": "h"
      },
      {
        "git": [
          "checkout",
          "-q",
          "main"
        ]
      }
    ],
    "applies": [
      {
        "id": "t1",
        "hash": "${h}",
        "branch": "agent"
      }
    ],
    "inspect": [
      "conflict.txt"
    ],
    "history_files": [
      "conflict.txt"
    ],
    "start_tier_files": [
      "conflict.txt"
    ],
    "expected": {
      "results": [
        {
          "taskId": "t1",
          "success": false,
          "resolvedTier": null,
          "error": "MERGE_CONFLICT (tier2 blocked): conflict.txt",
          "hasCommitHash": true
        }
      ],
      "files": {
        "conflict.txt": "main's important change\n"
      },
      "history": {
        "conflict.txt": [
          {
            "tier": 2,
            "success": false
          }
        ]
      },
      "startTiers": {
        "conflict.txt": 1
      },
      "porcelainClean": true,
      "cherryPickInProgress": false
    }
  },
