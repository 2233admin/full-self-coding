  {
    "name": "tier2_blocked_contentful_canonical",
    "target": "main",
    "steps": [
      {
        "write": [
          "conflict.txt",
          "original content\n"
        ]
      },
      {
        "git": [
          "add",
          "-A"
        ]
      },
      {
